{
  "name": "websk_skif",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "@hkvstore/rich-filemanager": "3.2.0",
    "ace-builds": "1.45.0",
    "admin-lte": "4.10.0",
    "blueimp-file-upload": "10.32.0",
    "bootstrap": "5.3.8",
    "glightbox": "3.3.1",
    "jodit": "4.18.4",
    "jquery": "3.7.1",
    "jquery-ui": "1.14.2",
    "jquery-validation": "1.22.1",
    "medium-editor": "5.23.3",
    "tokenize2": "https://github.com/dragonofmercy/Tokenize2/archive/refs/tags/1.3.5.tar.gz"
  },
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "lint:js": "eslint eslint.config.js playwright.config.mjs tests/browser public/assets/scripts resources/frontend scripts",
    "check:contracts": "node scripts/check-frontend-contracts.mjs",
    "check:assets": "node scripts/build-assets.mjs --check",
    "check": "npm run lint:js && npm run check:contracts && npm run check:assets",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "audit:high": "npm audit --audit-level=high"
  },
  "author": "support@websk.ru",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0"
  }
}
